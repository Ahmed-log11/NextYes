	diagnose -.-> prepare;
	extract -.-> __end__;
	extract -.-> await_documents;
	extract -.-> diagnose;
	plan -.-> __end__;
	plan -.-> await_owner;
	prepare -.-> submit_gate;
	submit -.-> __end__;
